							"protocol": "https",
							"host": ["nominatim", "openstreetmap", "org"],
							"path": ["search"],
							"query": [
								{"key": "q", "value": "Moscow"},
								{"key": "format", "value": "json"},
								{"key": "limit", "value": "1"},
								{"key": "accept-language", "value": "ru"}
							]
						}
					},
					"response": []
				}
