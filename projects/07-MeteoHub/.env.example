# Образец файла настроек. Скопируйте его в .env и впишите свой пароль.
# Файл .env в репозиторий не попадает (см. .gitignore).
# Имена переменных стандартные для PostgreSQL (libpq): их понимают и psql, и приложение.
PGHOST=localhost
PGPORT=5432
PGDATABASE=MeteoHub
PGUSER=crm_app
PGPASSWORD=ЗамениНаСвойПароль

# --- REST API ---
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# --- Open-Meteo (внешние источники) ---
OPEN_METEO_FORECAST=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE=https://archive-api.open-meteo.com/v1
OPEN_METEO_GEOCODING=https://geocoding-api.open-meteo.com/v1

# --- Кэш (в секундах) ---
CACHE_TTL_GEOCODE=86400
CACHE_TTL_WEATHER=3600