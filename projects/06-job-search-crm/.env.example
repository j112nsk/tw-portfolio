# Образец файла настроек. Скопируйте его в .env и впишите свой пароль.
# Файл .env в репозиторий не попадает (см. .gitignore).
# Имена переменных стандартные для PostgreSQL (libpq): их понимают и psql, и приложение.
PGHOST=localhost
PGPORT=5432
PGDATABASE=job_search_crm
PGUSER=crm_app
PGPASSWORD=change_me