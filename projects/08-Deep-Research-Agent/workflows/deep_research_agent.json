  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Выполни поиск по следующим темам: {{ $('Планировщик').first().json.text }}",
        "options": {
          "systemMessage": "Ты — профессиональный исследователь. Твоя задача — найти информацию с помощью инструмента searxng_search.\n1. Обязательно используй инструмент.\n2. Сделай 2-3 поисковых запроса (на английском, если тема техническая).\n3. Твой ответ должен содержать только факты, ссылки и выдержки из поиска.\n4. Если запрос просит найти ссылки на статьи или ресурсы — выдай их списком."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1184,
        -176
      ],
      "id": "da519c3c-9b34-4af5-a34d-c70a0f13ecde",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "description": "Search the web. Returns a JSON array of results with title, url, and snippet.",
        "jsCode": "// В structured mode query — это объект, из которого мы берём строку запроса\nconst searchQuery = query.query; \nconst url = 'http://searxng:8080/search?q=' + encodeURIComponent(searchQuery) + '&format=json';\n\ntry {\n  const data = await this.helpers.httpRequest({\n    method: 'GET',\n    url: url,\n    headers: { 'User-Agent': 'Mozilla/5.0 (compatible; n8n-bot/1.0)' },\n    json: true\n  });\n\n  if (!data.results || data.results.length === 0) {\n    return `По запросу \"${searchQuery}\" ничего не найдено.`;\n  }\n\n  const cleanResults = data.results.slice(0, 7).map(item => ({\n    title: item.title || 'Без названия',\n    url: item.url || '',\n    snippet: item.content ? item.content.substring(0, 400) + '...' : 'Нет описания'\n  }));\n\n  return JSON.stringify(cleanResults);\n} catch (error) {\n  return \"Ошибка поиска: \" + error.message;\n}",
        "specifyInputSchema": true,
        "jsonSchemaExample": "{\n  \"query\": \"Видеокарта RTX 4060 отзывы последние 30 дней 2024\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
